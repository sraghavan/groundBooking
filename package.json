{
  "name": "groundbooking",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "seed": "npm run seed -w api",
    "test": "npm test -w api",
    "build": "npm run build -w api && npm run build -w web",
    "start": "npm run start -w api",
    "import": "npm run import -w api --"
  },
  "engines": {
    "node": ">=22"
  }
}
